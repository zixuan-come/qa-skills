{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus",
          "default": "draft"
        },
        "source_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifacts",
          "type": "array"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "project_id",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "ArtifactStatus": {
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "superseded",
        "completed"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "TraceReference": {
      "additionalProperties": false,
      "description": "One explicit traceability row for strict structured model output.",
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "TraceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "environment": {
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "total_cases": {
      "minimum": 0,
      "title": "Total Cases",
      "type": "integer"
    },
    "passed": {
      "minimum": 0,
      "title": "Passed",
      "type": "integer"
    },
    "failed": {
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "blocked": {
      "minimum": 0,
      "title": "Blocked",
      "type": "integer"
    },
    "skipped": {
      "minimum": 0,
      "title": "Skipped",
      "type": "integer"
    },
    "defect_refs": {
      "items": {
        "type": "string"
      },
      "title": "Defect Refs",
      "type": "array"
    },
    "risk_summary": {
      "items": {
        "type": "string"
      },
      "title": "Risk Summary",
      "type": "array"
    },
    "conclusion": {
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "trace_refs": {
      "items": {
        "$ref": "#/$defs/TraceReference"
      },
      "title": "Trace Refs",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "scope",
    "environment",
    "total_cases",
    "passed",
    "failed",
    "blocked",
    "skipped",
    "conclusion"
  ],
  "title": "TestReport",
  "type": "object"
}
