{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus",
          "default": "draft"
        },
        "source_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifacts",
          "type": "array"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "project_id",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "ArtifactStatus": {
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "superseded",
        "completed"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "RequirementItem": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "actors": {
          "items": {
            "type": "string"
          },
          "title": "Actors",
          "type": "array"
        },
        "business_rules": {
          "items": {
            "type": "string"
          },
          "title": "Business Rules",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "postconditions": {
          "items": {
            "type": "string"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "title",
        "description"
      ],
      "title": "RequirementItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementItem"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "flows": {
      "items": {
        "type": "string"
      },
      "title": "Flows",
      "type": "array"
    },
    "states": {
      "items": {
        "type": "string"
      },
      "title": "States",
      "type": "array"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "requirements"
  ],
  "title": "RequirementAnalysis",
  "type": "object"
}
